# Copy to .env and fill in. Never commit .env. MOCK data only on free tiers.
#
# Option A: Google Gemini (free tier, key from https://aistudio.google.com/apikey)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
# LLM_REASONING_EFFORT=none   # optional: faster replies on "thinking" models
#
# Option B: Groq (free tier, key from https://console.groq.com/keys)
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=
#
# Option C: Ollama on your own PC (no key, nothing leaves your machine)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
#
# LLM_BASE_URL=   # only to override the provider's default endpoint
#
# EVAL_PAUSE_SECONDS=4   # pause between emails in eval/run_eval.py (free-tier rate limits)
